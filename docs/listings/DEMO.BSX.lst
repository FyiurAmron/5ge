10 GRAPHICS 15+16
11 FOR A=1 TO 140 STEP 1
13 COLOR 1:TEXT A,70,"atari"
14 NEXT A
16 FOR A=140 TO 70 STEP -1
17 COLOR 1:TEXT A,70,"atari"
18 NEXT A
19 FOR B=70 TO 0 STEP -1
20 COLOR 1:TEXT 70,B,"atari"
21 NEXT B
22 FOR B=0 TO 140 STEP 1
23 COLOR 1:TEXT 70,B,"atari"
24 NEXT B
25 FOR I=1 TO 400 STEP 1
30 COLOR 1:PLOT X,Y:X=RND*150:Y=RND*150
35 NEXT I
40 FOR I=0 TO 160 STEP 1
45 COLOR 1:TEXT I,70,"mini\IDEMO\i"
50 NEXT I
51 FOR A=1 TO 2
52 FOR I=160 TO 0 STEP -1
53 COLOR 2:TEXT I,70,"PGR"
54 NEXT I
55 NEXT A
60 COLOR 1:DRAWTO X,Y:X=RND*100:Y=RND*100:GOTO 60
