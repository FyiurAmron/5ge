26001 DATA *
26002 DATA *
26003 DATA Nic tu po tobie.
26004 DATA Tu jest tak ciemno ; że i ja nic nie    widzę
26005 DATA Spróbuj pohandlować.
26007 DATA *
26008 DATA Lepiej nie kąpać się w fosie.
26009 DATA Tu trzeba oddać wszystkie gówna.
26010 DATA Woda jest słona.
26011 DATA Uważaj ; żebyś nie spadł na mordę.
26012 DATA Spływaj stąd lepiej...
26013 DATA Wędka może służyć do różnych celów...
26014 DATA *
26015 DATA Od domu do muru prowadzą druty.
26016 DATA *
26017 DATA Lepiej tu nie srać...
26018 DATA Drzwi mogą cię zabić!
26019 DATA Piękną pogodę mamy dzisiaj!
26020 DATA *
26021 DATA Uważaj na żuli!
26022 DATA Rybak chce pić !
26023 DATA Gospodarz nie pozwoli ci wyłączyć prądu.
26024 DATA Eepch jest wygłodzony.
26025 DATA *
27000 DATA drzewo,100-letni dąb.Możesz się na niego       wspiąć.,1
27001 DATA łąkę,Zielona.,1
27002 DATA skałę,Chyba wapienna ; zbyt stroma by się na  nią wspinać z tej strony.,2
27003 DATA wejście,Nic nie widać.,2
27004 DATA jaskinię,Stąd ??,2
27005 DATA dźwięki,Przypominają rżenie konia.,2
27006 DATA drogę,Taka sobie; rozjeżdżona przez traktory.,16
27007 DATA skałę,Bardzo stroma.,4
27008 DATA skrzyżowanie,Jest tu drogowskaz.,5
27009 DATA drogowskaz,"Do zamku Ks. Bolka",5
27010 DATA morze,Raczej słone i głębokie.,10
27011 DATA piasek,Jest żółty i sypki.,10
27012 DATA czubek,Srak tu naptał.,11
27013 DATA most,Częściowo zwodzony.Od dawna nikt go nie naprawiał.,8
27014 DATA fosę,Jest w niej wskaźnik - pokazuje 8.5 m.  głębokości.,8
27015 DATA bramę,Ciężka ; z żelaznymi okuciami. Na każ-  dym skrzydle jest kołatka ; a na górze  widać herb Ks. Bolka,9
27016 DATA rzeczkę,10 m. szerokości ; płynie dość leniwie.,13
27017 DATA dróżkę,Zwykła ; polna dróżka,13
27018 DATA mostek,Uważaj ; bo się może pod tobą rozpaść !,14
27019 DATA poręcze,Jak widzisz - prawie ich nie ma.,14
27020 DATA podwórko,Typowe wiejskie podwórko ; dosyć zad-   bane.,15
27021 DATA sławojkę,Typowa wiejska sławojka z otworkiem.,15
27022 DATA oborę,Połączona z domem,15
27023 DATA dom,Drewniany.,15
27024 DATA sławojkę,Dosyć wygodna ; aczkolwiek wygląda na   lekko przepełnioną. Cuchnie nieludzko.,17
27025 DATA dziurę,Na krawędzi są jakieś białe ślady.,17
27026 DATA muchy,Ten gatunek lubił Eepchy!!,17
27027 DATA mur,Betonowy.Na wierzchu jest drut kolczas- ty.,18
27028 DATA furtkę,żelazna - na oko 40 mm grubości.,18
27029 DATA zamki,Jesteś zbyt kiepskim włamywaczem by je  otworzyć.,18
27030 DATA klamkę,Dosyć dziwnej konstrukcji.,18
27031 DATA druty,Kolczasty - i chyba pod napięciem.,18
27032 DATA pokój,40 m powierzchni,23
27033 DATA dywan,Perski.,23
27034 DATA regał,Jest na nim telewizor i masa książek.,23
27035 DATA stół,Zwyczajny.Stoi przy nim fotel.,23
27036 DATA szafa,Zamknięta na klucz.,23
27037 DATA bar,Typowy bar III kategorii (masa piwa i   żuli).,21
27038 DATA ladę,Nieco zalana piwem.,22
27039 DATA cennik,Jest tu coś napisane.,22
27040 DATA żuli,Lepiej im się nie przyglądaj za mocno.,22
27041 DATA żula,Którego ?,22
27042 DATA klatkę,Mocna ; żelazna.,24
27043 DATA Eepcha,Bardzo wygłodzony.,24
27044 DATA eepcha,Bardzo wygłodzony.,24
27045 DATA komórkę,Drewniana.,24
27046 DATA słoik,Ale który ??,25
27047 DATA słoiki,W środku jest żarcie dla Eepcha !,25
27048 DATA wyłącznik,Do furtki.,23
27500 DATA *,*,0
27501 DATA Jest coś na nim napisane
27502 DATA Bardzo stary ; dziś już nikt takich nie używa.
27503 DATA Nowiutka. Doskonała do kopania grobów.
27504 DATA Nieco stare ; ale niewątpliwie zrobione przez Eepcha.
27505 DATA Zwykła wędka bambusowa.
27506 DATA Zwykły hamburger ; nawet bez sałaty.
27507 DATA Puszkowane.
27508 DATA Eksportowe.
27509 DATA Sikacz ; dosyć mocno chrzczony.
27510 DATA Długa na 150 m.
27511 DATA Doskonały na rybki.
27512 DATA Dla profesjonalnego rybaka!
27513 DATA Niewątpliwie Eepcha.
27514 DATA Długa (1 m.) i ciężka (5 kg.).
27515 DATA Wygląda na gówienko Eepcha (dość małe).
27516 DATA Uniwersalna bumaga (chroni ; ratuje ;   pomaga).
27517 DATA Piękne brązowe gówienko!
27518 DATA Sam ją uświniłeś.
27519 DATA Eepch's Food- to było żarcie eksportowe!
27520 DATA Ogromne ; świeże ; cuchnące gówno!
27521 DATA Piękne okazy! W sam raz dla księcia!
27522 DATA "Hodowla i zastosowanie Eepchów"
